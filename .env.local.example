# Finnhub (finnhub.io 가입 → API 키 복사)
# 키가 없으면 앱은 모의 데이터 모드로 동작합니다.
FINNHUB_API_KEY=

# Supabase (대시보드 Connect → ORMs → Transaction pooler URI)
DATABASE_URL=

# AI — 둘 중 하나만 있으면 됨 (둘 다 없으면 AI 기능은 모의 모드)
# Anthropic: console.anthropic.com / OpenAI: platform.openai.com
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# 둘 다 넣었을 때 선택 (기본 anthropic): AI_PROVIDER=openai
# 모델 오버라이드(선택): ANTHROPIC_MODEL= / ANTHROPIC_MODEL_FAST= / OPENAI_MODEL= / OPENAI_MODEL_FAST=

# ── 한국 주식 ──
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ENV=real
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 한국 재무 보강 (ROE·부채비율·배당) — opendart.fss.or.kr 즉시 발급
# 발급 후: node scripts/load-dart-corpcodes.mjs 1회 실행
# DART_API_KEY=

# Cloudflare 리서치 Worker (서버 전용, NEXT_PUBLIC_ 접두어 금지)
# 로컬 실행: http://127.0.0.1:8787 / 운영: https://배포된-worker주소
# RESEARCH_WORKER_URL=
# Worker의 .dev.vars / 배포 secret과 같은 32자 이상 난수
# RESEARCH_WORKER_SECRET=
