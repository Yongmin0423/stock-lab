{
  "name": "stock-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "drizzle-kit push",
    "worker:dev": "wrangler dev --config workers/research/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "worker:types": "wrangler types workers/research/worker-configuration.d.ts --config workers/research/wrangler.jsonc --env-interface ResearchWorkerEnv",
    "worker:typecheck": "pnpm worker:types && tsc --project workers/research/tsconfig.json",
    "worker:dry-run": "wrangler deploy --config workers/research/wrangler.jsonc --dry-run",
    "worker:deploy": "wrangler deploy --config workers/research/wrangler.jsonc",
    "test:research": "node tests/research-worker.test.mjs",
    "test:research:runtime": "node tests/research-worker-runtime.test.mjs",
    "test:research:routes": "node tests/research-worker-route.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@sentry/nextjs": "^11.8.0",
    "drizzle-orm": "^0.44.0",
    "lightweight-charts": "^4.2.0",
    "next": "^16.3.1",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.156.0"
  }
}
